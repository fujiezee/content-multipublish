{
  "name": "content-multipublish",
  "version": "0.1.0",
  "private": true,
  "description": "Local multi-platform article publisher (Playwright + Next.js)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "browsers": "playwright install chromium",
    "postinstall": "npm run browsers",
    "typecheck": "tsc --noEmit",
    "geo:build": "npm run build --prefix tools/dianwu-geo-cli",
    "geo:serve": "npm run start --prefix tools/dianwu-geo-cli",
    "geo:mcp": "npm run dianwu-geo --prefix tools/dianwu-geo-cli -- mcp",
    "geo:sync": "npm run dianwu-geo --prefix tools/dianwu-geo-cli -- sync",
    "geo:platforms": "npm run dianwu-geo --prefix tools/dianwu-geo-cli -- platforms"
  },
  "dependencies": {
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-table-cell": "^3.29.2",
    "@tiptap/extension-table-header": "^3.29.2",
    "@tiptap/extension-table-row": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "better-sqlite3": "^13.0.2",
    "marked": "^18.0.7",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
