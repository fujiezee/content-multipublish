{
  "manifest_version": 3,
  "name": "点物GEO 文章多平台同步助手",
  "description": "点物GEO 文章多平台同步助手 · https://dianwu.ai",
  "version": "2.6.0",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_icon": "assets/icon-48.png",
    "default_popup": "src/popup/index.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "cookies",
    "notifications",
    "offscreen",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "tabs",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://localhost/*",
      "https://127.0.0.1/*",
      "https://dianwu.ai/*"
    ]
  },
  "content_scripts": [
    {
      "js": [
        "page-sync-mark.js"
      ],
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*",
        "https://127.0.0.1/*",
        "http://*/*",
        "https://dianwu.ai/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "page-sync-api.js"
      ],
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*",
        "https://127.0.0.1/*",
        "http://*/*",
        "https://dianwu.ai/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "assets/weixin.ts-DM4ajTxm.js"
      ],
      "matches": [
        "https://mp.weixin.qq.com/s/*",
        "https://mp.weixin.qq.com/s?*"
      ],
      "run_at": "document_end"
    },
    {
      "js": [
        "assets/weixin-editor.ts-loader-ZIiQxvot.js"
      ],
      "matches": [
        "https://mp.weixin.qq.com/cgi-bin/appmsg*"
      ],
      "run_at": "document_end"
    },
    {
      "js": [
        "assets/toutiao.ts-loader-DpEsQ3dD.js"
      ],
      "matches": [
        "https://mp.toutiao.com/*"
      ],
      "run_at": "document_end"
    },
    {
      "js": [
        "assets/reader.js-Cie-k7Ey.js",
        "assets/Readability.js-DC-iE2S6.js",
        "assets/extractor.ts-loader-BH2EWQja.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/*",
        "src/editor/index.html",
        "inject-api.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://mp.weixin.qq.com/*",
        "https://mp.weixin.qq.com/*"
      ],
      "resources": [
        "assets/weixin.ts-DM4ajTxm.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://mp.weixin.qq.com/*"
      ],
      "resources": [
        "assets/logger-CvfM-6aa.js",
        "assets/weixin-editor.ts-pcC4u-Av.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://mp.toutiao.com/*"
      ],
      "resources": [
        "assets/logger-CvfM-6aa.js",
        "assets/toutiao.ts-Brq6w7IU.js"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "resources": [
        "assets/reader.js-Cie-k7Ey.js",
        "assets/Readability.js-DC-iE2S6.js",
        "assets/logger-CvfM-6aa.js",
        "assets/index.browser-jmXnl6ZB.js",
        "assets/extractor.ts-Cucy8zre.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "declarative_net_request": {
